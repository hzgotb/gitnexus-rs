FROM rust:1.85-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        cmake \
        clang \
        build-essential \
        pkg-config \
        git \
    && rm -rf /var/lib/apt/lists/*

RUN rustup set profile minimal \
    && rustup toolchain install 1.88.0 \
    && rustup default 1.88.0

WORKDIR /workspace

ENV CARGO_TERM_COLOR=always

CMD ["bash"]
